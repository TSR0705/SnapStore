# EditorConfig configuration for FileX
# Standard: FAANG/Enterprise OSS consistency

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{gradle,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false # Markdown trailing space is meaningful
