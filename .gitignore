# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
bin/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Database
data/
*.db
*.db-shm
*.db-wal

# Application Runtime
config/*.properties
config/*.yml
config/*.yaml
!config/*.example.*

# Temporary Files
*.tmp
*.temp
*.swp
*.swo
*~

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Test Reports
test-results/
test-output/
*.hprof

# Build Artifacts
out/
target/
dist/
