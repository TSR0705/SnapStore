<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="replayRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.filex.controller.ReplayController"
      spacing="15" style="-fx-padding: 20;">
    
    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Timeline Replay" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="positionLabel" text="Position: 0/0" style="-fx-font-size: 12px;"/>
        <Button fx:id="backButton" text="Back"/>
        <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="20" prefHeight="20"/>
    </HBox>
    
    <Label fx:id="incidentIdLabel" text="Replaying Incident: -" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
    
    <Separator/>
    
    <!-- Error display with retry -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="errorLabel" visible="false" style="-fx-text-fill: #d32f2f;" wrapText="true" HBox.hgrow="ALWAYS"/>
        <Button fx:id="retryButton" text="Retry" visible="false"/>
    </HBox>
    
    <!-- Replay Controls -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="jumpToStartButton" text="|◀" prefWidth="60">
            <tooltip>
                <Tooltip text="Jump to Start"/>
            </tooltip>
        </Button>
        <Button fx:id="stepBackwardButton" text="◀" prefWidth="60">
            <tooltip>
                <Tooltip text="Step Backward"/>
            </tooltip>
        </Button>
        <Button fx:id="stepForwardButton" text="▶" prefWidth="60">
            <tooltip>
                <Tooltip text="Step Forward"/>
            </tooltip>
        </Button>
        <Button fx:id="jumpToEndButton" text="▶|" prefWidth="60">
            <tooltip>
                <Tooltip text="Jump to End"/>
            </tooltip>
        </Button>
    </HBox>
    
    <Separator/>
    
    <!-- Replay Timeline and Detail Split -->
    <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
        
        <!-- Left: Timeline Events -->
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Timeline Events (Deterministic Order)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ListView fx:id="replayListView" VBox.vgrow="ALWAYS" 
                      style="-fx-font-family: monospace; -fx-font-size: 11px;"/>
            <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        
        <!-- Right: Event Detail -->
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Event Details" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TextArea fx:id="eventDetailArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: monospace;"/>
        </VBox>
        
    </SplitPane>
    
</VBox>
