<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="detailRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.filex.controller.IncidentDetailController"
      spacing="15" style="-fx-padding: 20;">
    
    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Incident Details" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="20" prefHeight="20"/>
    </HBox>
    
    <Separator/>
    
    <!-- Error display -->
    <Label fx:id="errorLabel" visible="false" style="-fx-text-fill: #d32f2f;" wrapText="true"/>
    
    <!-- Incident Summary -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        
        <Label text="Incident ID:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="incidentIdLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Title:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="titleLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Severity:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="severityLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Confidence:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="confidenceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Status:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="statusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Detected At:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="detectedAtLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        
        <Label text="Evidence Count:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <Label fx:id="evidenceCountLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    </GridPane>
    
    <Separator/>
    
    <!-- Evidence Preview -->
    <VBox spacing="10">
        <Label text="Evidence Preview" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <ListView fx:id="evidencePreviewList" prefHeight="150" VBox.vgrow="SOMETIMES"/>
    </VBox>
    
    <!-- Action Buttons -->
    <HBox spacing="10">
        <Button fx:id="viewAllEvidenceButton" text="View All Evidence" prefWidth="150"/>
        <Button fx:id="replayTimelineButton" text="Replay Timeline" prefWidth="150"/>
        <Button fx:id="viewRelatedButton" text="View Related" prefWidth="150"/>
    </HBox>
    
</VBox>
